# ---- Shopify (from Partner Dashboard > your app > API credentials) ----
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=read_orders,read_customers,read_products

# App Proxy shared secret == SHOPIFY_API_SECRET (used to sign proxy requests)

# ---- Neon Postgres (from Neon dashboard > Connection string, pooled) ----
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# ---- AI provider (free tiers) ----
# Primary: Google Gemini Flash (free ~15 RPM, 1M tokens/day). Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key
# Fallback: Groq (free ~30 RPM, no card). Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key

# 32-byte hex string to encrypt stored access tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENC_KEY=replace_with_openssl_rand_hex_32

# ---- Email channel (Resend) ----
# Merchants forward their support inbox to <token>@RESEND_INBOUND_DOMAIN, and
# Resend posts arriving mail to /api/webhooks/email.
# Leave these unset to keep the Emails page disabled.
RESEND_API_KEY=re_your_key
RESEND_INBOUND_DOMAIN=inbound.yourdomain.com
# Verified sender replies go out from.
RESEND_FROM=support@yourdomain.com
# Signing secret from the Resend webhook (starts with whsec_). Without it the
# inbound webhook rejects everything, since anyone could otherwise post fake
# customer emails into a merchant's inbox.
RESEND_WEBHOOK_SECRET=whsec_your_secret
