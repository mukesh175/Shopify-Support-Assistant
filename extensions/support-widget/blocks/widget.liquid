{% comment %}
  App embed block. Merchant enables this under Theme Customize > App embeds
  and customizes color, icon, position, and greeting from there.
{% endcomment %}

<div
  id="support-assistant-root"
  data-proxy-url="/apps/support/query"
  data-accent="{{ block.settings.accent_color }}"
  data-text-color="{{ block.settings.text_color }}"
  data-greeting="{{ block.settings.greeting | escape }}"
  data-popup="{{ block.settings.popup_text | escape }}"
  data-icon="{{ block.settings.launcher_icon }}"
  data-position="{{ block.settings.position }}"
  data-brand-name="{{ shop.name | escape }}"
  data-customer-name="{{ customer.first_name | escape }}"
></div>

<link rel="stylesheet" href="{{ 'widget.css' | asset_url }}">
<script src="{{ 'widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Zappy",
  "target": "body",
  "settings": [
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "accent_color", "label": "Main color (button & header)", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "Button/header text color", "default": "#ffffff" },
    {
      "type": "select", "id": "launcher_icon", "label": "Chat button icon",
      "options": [
        { "value": "bubble", "label": "Chat bubble" },
        { "value": "headset", "label": "Headset" },
        { "value": "robot", "label": "Robot" },
        { "value": "question", "label": "Question mark" }
      ],
      "default": "bubble"
    },
    {
      "type": "select", "id": "position", "label": "Position on screen",
      "options": [
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "right"
    },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "greeting", "label": "Greeting (inside chat)", "default": "Hi! Ask about your order or our policies." },
    { "type": "text", "id": "popup_text", "label": "Popup bubble text (leave blank to hide)", "default": "Hello 👋 How can I help?" },
    { "type": "header", "content": "WhatsApp" },
    {
      "type": "paragraph",
      "content": "WhatsApp handoff is set up in the Zappy app under Settings. It is available on the Starter and Pro plans."
    }
  ]
}
{% endschema %}
